<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Condition="Exists('..\TargetDirectories.targets')" Project="..\TargetDirectories.targets"/>
    
    <ItemGroup>
        <CopyToBuildFiles Include="CopyToBuild/*"/>
    </ItemGroup>
    
    <Target Condition="Exists('.\..\TargetDirectories.targets')" Name="CopyAssemblyToBepInEx" AfterTargets="ILRepacker">
        <MakeDir Directories="$(ModDir)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDir)"/>
        <Copy SourceFiles=".\3rd-Party-Licenses.txt" DestinationFolder="$(ModDir)"/>
        <Copy SourceFiles="@(CopyToBuildFiles)" DestinationFolder="$(ModDir)"/>
    </Target>
</Project>