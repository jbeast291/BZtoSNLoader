<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Condition="Exists('TargetDirectories.targets')" Project="TargetDirectories.targets"/>
    
    <ItemGroup>
        <DataFiles Include="Data/*"/>
    </ItemGroup>
    
    <Target Condition="Exists('.\TargetDirectories.targets')" Name="CopyAssemblyToBepInEx" AfterTargets="Build">
        <MakeDir Directories="$(ModDir)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDir)"/>
    </Target>

    <Target Condition="Exists('.\TargetDirectories.targets')" Name="CopyDataToBepInEx" AfterTargets="Build">
        <MakeDir Directories="$(ModDir)"/>
        <Copy SourceFiles="@(DataFiles)" DestinationFolder="$(ModDir)"/>
    </Target>
</Project>